# Install on the dedicated API server. tools.cjaffa.com remains on GitHub Pages.
portal-api.cjaffa.com {
    header Strict-Transport-Security "max-age=31536000"
    request_body {
        max_size 16KB
    }
    reverse_proxy 127.0.0.1:8787 {
        header_up X-Portal-Client-IP {http.request.remote.host}
    }
}
