[Unit]
Description=CJ private library API
After=network.target

[Service]
User=cj-private
Group=cj-private
WorkingDirectory=/opt/cj-private
EnvironmentFile=/etc/cj-private.env
ExecStart=/usr/bin/node /opt/cj-private/server.mjs
Restart=on-failure
StateDirectory=cj-private
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cj-private

[Install]
WantedBy=multi-user.target
